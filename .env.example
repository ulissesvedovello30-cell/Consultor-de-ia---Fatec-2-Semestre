# Copie para .env. Não publique o arquivo preenchido.
MYSQL_HOST=127.0.0.1
MYSQL_PORTA=3306
MYSQL_USUARIO=
MYSQL_SENHA=
MYSQL_DATABASE=

# Chave fica SOMENTE no servidor. Não inserir no HTML ou JavaScript.
GEMINI_API_KEY=
# Consulte os modelos disponíveis: python verificar_gemini.py
GEMINI_MODELO=
GEMINI_EMBEDDING=gemini-embedding-001
RAG_LIMIAR_SIMILARIDADE=0.65
RAG_TEMPO_TOTAL=60

APP_ORIGIN=http://127.0.0.1:8000
# Gerados por python preparar_admin.py; não colocar senha em texto simples.
ADMIN_USUARIO=admin
ADMIN_SENHA_HASH=

# Preencher antes de oferecer atendimento institucional.
PRIVACIDADE_RESPONSAVEL=
PRIVACIDADE_CONTATO=

# Segundo fator obrigatório para login no modo oficial: python configurar_2fa.py
ADMIN_TOTP_SECRET=
# Opcional: caminho absoluto para volume persistente privado (padrão runtime/seguranca.sqlite3).
# SEGURANCA_DB=
# Apenas ao usar o Nginx entregue no mesmo servidor: TRUSTED_PROXIES=127.0.0.1
# Não preencha se o usuário acessa o Uvicorn diretamente na máquina local.
TRUSTED_PROXIES=
# Porta interna do Uvicorn (HTTPS público termina no proxy).
APP_PORT=8000
