# Copie para .env. Não publique o arquivo preenchido.
# MVP disponível. postgres está reservado e encerra com aviso nesta versão.
CHATBOT_PERFIL=mvp
# Caminho relativo à raiz do projeto ou absoluto em um volume persistente.
SQLITE_CAMINHO=runtime/acervo.sqlite3

# Chave fica SOMENTE no servidor. Não inserir no HTML ou JavaScript.
GEMINI_API_KEY=
# Consulte os modelos disponíveis: python verificar_gemini.py
GEMINI_MODELO=gemini-3.5-flash
GEMINI_EMBEDDING=gemini-embedding-001
# textual: SQLite FTS5 sem API de embeddings. gemini: vetorial remoto opcional.
BUSCA_ACERVO=textual
RAG_LIMIAR_SIMILARIDADE=0.65
RAG_TEMPO_TOTAL=60

APP_ORIGIN=http://127.0.0.1:8000
# Gerados por python preparar_admin.py; não colocar senha em texto simples.
ADMIN_USUARIO=admin
ADMIN_SENHA_HASH=

# Preencher antes de oferecer atendimento institucional.
PRIVACIDADE_RESPONSAVEL=
PRIVACIDADE_CONTATO=

# Segundo fator obrigatório para login no MVP: python configurar_2fa.py
ADMIN_TOTP_SECRET=
# Opcional: caminho absoluto para volume persistente privado (padrão runtime/seguranca.sqlite3).
# SEGURANCA_DB=
# Apenas ao usar o Nginx entregue no mesmo servidor: TRUSTED_PROXIES=127.0.0.1
# Não preencha se o usuário acessa o Uvicorn diretamente na máquina local.
TRUSTED_PROXIES=
# Em HTTP local, use a mesma porta em APP_ORIGIN; em HTTPS ela pode ser interna.
APP_PORT=8000

# Opcional; somente usado com python servidor.py --ngrok.
NGROK_AUTHTOKEN=
